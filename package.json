{
  "name": "mandarin-tone-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Mandarin tone training app for Android and the browser",
  "scripts": {
    "setup": "python3 scripts/bootstrap.py",
    "verify:setup": "python3 scripts/bootstrap.py --verify-only",
    "build:mobile": "node scripts/build_mobile_assets.mjs",
    "build:mobile:local": "node scripts/build_mobile_assets.mjs --local-use",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:sync:local": "npm run build:mobile:local && npx cap sync android",
    "android:open": "npm run cap:sync && npx cap open android",
    "android:debug": "npm run cap:sync:local && cd android && ./gradlew assembleDebug",
    "android:signing": "python3 scripts/configure_android_signing.py",
    "android:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "audit:tones": "python3 scripts/audit_correction_tones.py --fail-on-unquarantined",
    "audit:similarity": "python3 scripts/audit_correction_similarity.py --fail-on-unquarantined",
    "audit:corrections": "npm run audit:tones && npm run audit:similarity",
    "audit:listening": "node scripts/review_audio.mjs",
    "judge:reference": "python3 scripts/download_judge_reference.py",
    "judge:prepare": "python3 scripts/calibrated_pronunciation_judge.py prepare && python3 scripts/refine_pronunciation_judge.py prepare",
    "judge:train": "python3 scripts/refine_pronunciation_judge.py development && python3 scripts/refine_pronunciation_judge.py train",
    "judge:baseline": "python3 scripts/calibrated_pronunciation_judge.py train",
    "judge:score": "python3 scripts/calibrated_pronunciation_judge.py score",
    "native:inventory": "python3 scripts/native_tone_validator.py inventory",
    "native:train": "python3 scripts/native_tone_validator.py train",
    "native:prepare": "python3 scripts/native_tone_validator.py prepare",
    "native:score": "python3 scripts/native_tone_validator.py score",
    "native:score-file": "python3 scripts/native_tone_validator.py score-file",
    "native:audit-plan": "python3 scripts/native_tone_validator.py audit-plan",
    "native:calibrate-gold": "python3 scripts/native_tone_validator.py calibrate-gold",
    "native:evaluate-gold": "python3 scripts/native_tone_validator.py evaluate-gold",
    "audio:mix": "python3 scripts/build_mixed_audio_bank.py",
    "audio:identity-gaps": "python3 scripts/verify_comparison_identity.py",
    "audio:coverage": "node scripts/report_mixed_audio_coverage.mjs",
    "audit:agreement-selection": "node scripts/build_agreement_practice.mjs",
    "download:mandarin-native": "python3 scripts/download_mandarin_native.py --standalone-only",
    "test": "python3 -m unittest discover -s tests -q"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
